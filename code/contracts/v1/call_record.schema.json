{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "softsim://contracts/v1/call_record",
  "type": "object",
  "required": ["schema_name", "schema_version", "run_id", "task_id", "episode_id", "record_sha256", "metrics"],
  "properties": {
    "schema_name": {"const": "softsim.call_record"},
    "schema_version": {"const": 1},
    "record_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "metrics": {"type": "object"}
  },
  "additionalProperties": true
}
