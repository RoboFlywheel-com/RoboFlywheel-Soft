{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "softsim://contracts/v1/analysis_spec",
  "type": "object",
  "required": ["figure_id", "input_tables", "group_by", "metric_names", "bootstrap_seed", "cluster_key"],
  "properties": {
    "figure_id": {"type": "string"},
    "input_tables": {"type": "array", "minItems": 1},
    "group_by": {"type": "array"},
    "metric_names": {"type": "array", "minItems": 1},
    "bootstrap_seed": {"type": "integer"},
    "cluster_key": {"type": "string"},
    "formal_numbers_allowed": {"const": false}
  },
  "additionalProperties": true
}
