{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "softsim://contracts/v1/physical_release",
  "type": "object",
  "required": ["schema_name", "schema_version", "release_id", "publishable", "population_count"],
  "properties": {
    "schema_name": {"const": "softsim.physical_release_manifest"},
    "schema_version": {"const": 12},
    "release_id": {"type": "string"},
    "publishable": {"const": true},
    "population_count": {"type": "integer", "minimum": 1},
    "index_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
