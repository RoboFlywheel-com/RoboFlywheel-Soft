{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://softsim.local/schema/fragile-soft-instance-v1.json",
  "type": "object",
  "required": ["schema_version", "benchmark_instance_id", "canonical_group_id", "geometry_revision_id", "physical_bundle_id", "material_model_id", "damage_model_id", "difficulty_id", "split", "scenario", "source", "source_hash", "status"],
  "properties": {
    "schema_version": {"const": "fragile-soft.instance.v1"},
    "benchmark_instance_id": {"type": "string", "pattern": "^fsb-[a-z0-9_]+-r[0-9]{3}-d[0-9]{2}$"},
    "benchmark_population": {"const": "benchmark instances"},
    "unique_geometry_asset": {"type": "boolean"},
    "canonical_group_id": {"type": "string", "minLength": 1},
    "canonical_id": {"type": "string", "minLength": 1},
    "base_asset_id": {"type": "string", "minLength": 1},
    "geometry_revision_id": {"type": "string", "minLength": 1},
    "physical_bundle_id": {"type": ["string", "null"]},
    "provisional_physical_bundle_id": {"type": "string", "minLength": 1},
    "physical_bundle_status": {"enum": ["unjoined", "verified", "rejected", "task_failure", "missing", "ambiguous"]},
    "physical_join_status": {"enum": ["unjoined", "joined_verified", "joined_nonverified", "missing", "ambiguous"]},
    "formal_join_ready": {"type": "boolean"},
    "physical_release_id": {"type": ["string", "null"]},
    "sample_id": {"type": ["string", "null"]},
    "asset_revision_id": {"type": ["string", "null"]},
    "material_model_id": {"type": "string", "minLength": 1},
    "damage_model_id": {"type": "string", "minLength": 1},
    "difficulty_id": {"type": "string", "pattern": "^d[0-9]{2}$"},
    "split": {"enum": ["calibration", "dev", "hidden_test", "hidden"]},
    "calibration_or_hidden_split": {"type": "string"},
    "scenario": {"$ref": "scenario.schema.json"},
    "source": {"type": "object", "required": ["p0_asset_source_sha256", "p0_adapter_schema"], "properties": {"p0_asset_source_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "p0_adapter_schema": {"const": "fragile-soft.p0-adapter.v1"}}},
    "source_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"enum": ["candidate", "rejected_unsupported_material", "rejected_invalid_material", "qualified", "rejected"]},
    "e3_a_eligible": {"type": "boolean"}
  },
  "additionalProperties": true
}
