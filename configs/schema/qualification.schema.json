{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://softsim.local/schema/fragile-soft-qualification-v1.json",
  "type": "object",
  "required": ["schema_version", "qualification_id", "instance_count", "qualified_count", "rejected_count", "status", "e3_a_eligible", "instance_reports", "qualification_report_hash"],
  "properties": {
    "schema_version": {"const": "fragile-soft.qualification.v1"},
    "qualification_id": {"const": "fragile-soft-qualification-v1"},
    "instance_count": {"type": "integer", "minimum": 1},
    "qualified_count": {"type": "integer", "minimum": 0},
    "rejected_count": {"type": "integer", "minimum": 0},
    "status": {"enum": ["qualified", "rejected"]},
    "e3_a_eligible": {"type": "boolean"},
    "instance_reports": {"type": "array", "minItems": 1},
    "qualification_report_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
